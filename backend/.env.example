# Copy to .env and edit:  cp .env.example .env   (Windows: copy .env.example .env)
#
# app/__init__.py reads backend/.env on startup, before anything else in the
# package looks at the environment. A real environment variable always wins
# over a line in here, so a hosted deployment (Render, Docker, Fly) keeps
# setting its own and a .env left in the image is ignored.
#
# .env is in .gitignore. .env.example is not — keep real credentials out of it.

# --- Database --------------------------------------------------------------
# SQLite needs no install and is fine for a team of 10-15.
DATABASE_URL=sqlite:///./dispatch.db

# Managed Postgres, when you outgrow it. Paste the string exactly as the host
# gives it to you: postgres:// and postgresql:// are both normalised to
# postgresql+psycopg2:// in app/main.py.
#   Neon:  DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   Local: DATABASE_URL=postgresql+psycopg2://dispatch:dispatch@localhost:5432/dispatch

# --- Sessions --------------------------------------------------------------
# Sign tokens with a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out; it does not touch anybody's password.
# The value below is a placeholder committed to git — generate your own.
JWT_SECRET=change-me-before-you-deploy-this
JWT_HOURS=12

# --- Browser app -----------------------------------------------------------
# Where the browser app is served from. Empty when one process serves both.
CORS_ORIGINS=http://localhost:5173
