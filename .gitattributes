# The deploy scripts run on Linux. Checked out on Windows and copied to the
# server, a CRLF would make bash fail with "bad interpreter: no such file or
# directory" -- a confusing error for a file that plainly exists. Keep them LF
# whatever the checkout platform does.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
deploy/*.conf   text eol=lf
Dockerfile      text eol=lf
