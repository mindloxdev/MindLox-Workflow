# Production settings for Dispatch on your own server.
#
# deploy/install.sh writes /opt/bd-dispatch/backend/.env from this file on the
# first install, filling in DATABASE_URL and JWT_SECRET with values it
# generates itself. You only edit this by hand to change a setting later:
#
#     sudo nano /opt/bd-dispatch/backend/.env
#     sudo systemctl restart bd-dispatch
#
# The real .env is chmod 600, owned by the dispatch account, and never leaves
# this machine. This example is committed to git -- keep real values out of it.

# --- Database --------------------------------------------------------------
# PostgreSQL on this server, listening on 127.0.0.1 only. The password is the
# one in /opt/bd-dispatch/.db-password; if you change one, change the other.
DATABASE_URL=postgresql+psycopg2://dispatch:CHANGE_ME@127.0.0.1:5432/dispatch

# --- Sessions --------------------------------------------------------------
# Signs the sign-in tokens. A long random string, unique to this server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out; it does not touch anybody's password.
JWT_SECRET=CHANGE_ME
# How long a sign-in lasts before the person has to sign in again.
JWT_HOURS=12

# --- Browser app -----------------------------------------------------------
# Empty on purpose. One process serves both the browser app and the API
# (WEB_ROOT, set in the systemd unit), so there is no other origin to allow.
CORS_ORIGINS=

# --- Public address (https) -----------------------------------------------
# Set by deploy/enable-https.sh; you do not need to edit these by hand. With
# DOMAIN set and a certificate issued, install.sh and update.sh configure
# nginx for https at this name, and http plus the LAN address redirect to it.
# Empty: plain http on the LAN only.
DOMAIN=server.mindlox.io
# Let's Encrypt writes here if a certificate is about to expire unrenewed.
CERTBOT_EMAIL=

# --- Background work -------------------------------------------------------
# How often, in seconds, the rebuild timer looks for a cycle that is due.
# 0 turns it off.
AUTO_BUILD_TICK_SECONDS=60

# The clock people read timestamps in. Stored times stay UTC regardless.
# The browser app has its own copy of this in EntryTable -- change both.
TIMEZONE=America/New_York

# --- First manager (starting empty only) -----------------------------------
# On a database with no users, these create the first manager at startup.
# Not needed after migrating from Neon -- everyone comes across with their
# password. If you do use them: sign in, change the password, then delete
# both lines. deploy/create-manager.sh does the same without them.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=at-least-8-characters
